---
import type { BlogPost } from "@/data/blog";

const { post } = Astro.props as { post: BlogPost };
---

<article class="post-card">
  <img src={post.heroImage} alt="" loading="lazy" />
  <div>
    <p class="meta">{post.category} / {new Date(post.pubDate).toLocaleDateString("ru-RU")}</p>
    <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
    <p>{post.description}</p>
    <div class="tags">
      {post.tags.map((tag) => <span>{tag}</span>)}
    </div>
  </div>
</article>

<style>
  .post-card {
    display: grid;
    grid-template-rows: 180px 1fr;
    overflow: hidden;
    border: 1px solid rgba(19, 181, 236, 0.2);
    border-radius: 8px;
    background: rgba(17, 26, 22, 0.7);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #0a0f0d;
  }

  div {
    padding: 22px;
  }

  .meta {
    margin-bottom: 10px;
    color: #13b5ec;
    font-size: 13px;
    font-weight: 800;
  }

  h3 a:hover { color: var(--accent); text-decoration: underline; }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    padding: 0;
  }

  span {
    border: 1px solid rgba(19, 181, 236, 0.25);
    border-radius: 999px;
    padding: 4px 9px;
    color: #86efac;
    font-size: 12px;
    font-weight: 700;
  }
</style>
