---
import { site } from "@/config/site";
---

<section class="archive-notice">
  <div>
    <strong>Index update</strong>
    <p>
      FantomMarketCap tracks new tokens, DEX listings, and liquidity shifts across the Fantom
      ecosystem. Data refreshes regularly as markets evolve.
    </p>
  </div>
  <a href={`mailto:${site.email}`}>Suggest a token</a>
</section>

<style>
  .archive-notice {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 16px clamp(18px, 5vw, 64px);
    border-bottom: 1px solid rgba(19, 181, 236, 0.2);
    background: rgba(17, 26, 22, 0.85);
  }

  strong {
    display: block;
    margin-bottom: 2px;
  }

  p {
    max-width: 860px;
    font-size: 14px;
  }

  a {
    flex: 0 0 auto;
    color: #13b5ec;
    font-weight: 800;
  }

  @media (max-width: 700px) {
    .archive-notice {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
