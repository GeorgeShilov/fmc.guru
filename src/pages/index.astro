---
import Layout from '@/layouts/Layout.astro'; import LeadDialog from '@/components/LeadDialog.astro';
---
<Layout title="Fantom market intelligence"><div class="terminal"><header><b>FMC//GURU</b><span>FANTOM MARKET CONSOLE</span><i>NETWORK ONLINE ●</i></header><section class="scan"><div><p class="code">QUERY: WHERE IS FANTOM MOVING?</p><h1>Read the chain.<br/><mark>Catch the signal.</mark></h1><p>Independent dashboards and field research for builders navigating the Fantom ecosystem.</p><button data-lead>REQUEST A RESEARCH BRIEF ↗</button></div><img src="/assets/generated/hero-fantom.jpg" alt="Fantom network intelligence visualization"/></section><section class="tape"><span>FTM $0.00</span><span>ACTIVE PROTOCOLS 126</span><span>BLOCK TIME 0.8S</span><span>FEAR / GREED 61</span></section><section class="grid"><aside><h2>Signal desk</h2><p>Updated research lanes</p></aside><article><small>01 / LIQUIDITY</small><h3>Capital flow monitor</h3><div class="bars"><i/><i/><i/><i/><i/></div></article><article><small>02 / BUILDERS</small><h3>Protocol activity</h3><p class="number">126</p></article><article><small>03 / NARRATIVE</small><h3>Weekly field memo</h3><button data-lead>GET THE MEMO</button></article></section><section class="desk"><img src="/assets/generated/research-desk.jpg" alt="Crypto research desk"/><div><p class="code">HUMAN INTERPRETATION LAYER</p><h2>Dashboards show movement. We explain why it matters.</h2><button data-lead>OPEN A CHANNEL</button></div></section><LeadDialog /></div></Layout>
<style>:global(.site-header),:global(.site-footer){display:none}.terminal{background:#050807;color:#c6ffd7;min-height:100vh;font-family:ui-monospace,SFMono-Regular,monospace}.terminal>header{height:58px;display:flex;justify-content:space-between;align-items:center;padding:0 3vw;border-bottom:1px solid #21472e;font-size:.78rem}.terminal header i{color:#48ff7d}.scan{display:grid;grid-template-columns:1fr 1fr;min-height:75vh;padding:4vw;gap:4vw;align-items:center}.scan h1{font-size:clamp(3.4rem,7vw,7rem);line-height:.92;letter-spacing:-.07em}.scan mark{background:#48ff7d;color:#050807;padding:0 .12em}.scan p{max-width:620px}.scan img{width:100%;height:62vh;object-fit:cover;border:1px solid #48ff7d;clip-path:polygon(0 8%,8% 0,100% 0,100% 92%,92% 100%,0 100%)}button{background:#48ff7d;color:#050807;border:0;padding:15px 18px;font:inherit;font-weight:900}.code{font-size:.76rem;letter-spacing:.12em}.tape{display:flex;justify-content:space-around;gap:30px;overflow:hidden;white-space:nowrap;padding:12px;border-block:1px solid #21472e}.grid{display:grid;grid-template-columns:1fr 1fr 1fr 1fr}.grid>*{min-height:280px;padding:28px;border-right:1px solid #21472e;border-bottom:1px solid #21472e}.grid h3{font-size:1.6rem}.number{font-size:5rem}.bars{display:flex;align-items:end;height:120px;gap:8px}.bars i{width:18%;height:30%;background:#48ff7d}.bars i:nth-child(2){height:70%}.bars i:nth-child(3){height:48%}.bars i:nth-child(4){height:90%}.bars i:nth-child(5){height:62%}.desk{display:grid;grid-template-columns:1.2fr 1fr;align-items:center}.desk img{width:100%;height:560px;object-fit:cover;filter:hue-rotate(60deg)}.desk div{padding:5vw}.desk h2{font-size:clamp(2.4rem,4vw,4rem)}@media(max-width:760px){.terminal>header span{display:none}.scan,.desk{grid-template-columns:1fr}.scan img{height:45vh}.grid{grid-template-columns:1fr 1fr}.grid aside{grid-column:span 2}}</style>
