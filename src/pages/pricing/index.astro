---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Pricing">
  <section class="section">
    <div class="section-inner">
      <p class="eyebrow">Pricing</p>
      <h1>Data plans for every trader.</h1>
      <p class="lead">
        Start with free rankings and DEX listings, then add real-time feeds, API access, and advanced filters as your strategy scales.
      </p>
      <div class="grid pricing">
        <article class="card"><h3>Scout</h3><p>Token rankings, category filters, DEX directory, and basic market cap data.</p><strong>Free</strong></article>
        <article class="card"><h3>Trader</h3><p>Real-time price feeds, liquidity depth, on-chain alerts, and portfolio tracking.</p><strong>$29/mo</strong></article>
        <article class="card"><h3>Pro</h3><p>API access, custom filters, historical snapshots, and priority support for power users.</p><strong>Custom</strong></article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .pricing {
    margin-top: 42px;
  }

  strong {
    display: block;
    margin-top: 28px;
    font-size: 30px;
  }
</style>
