---
import PostCard from "@/components/PostCard.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const mapped = posts.map((entry) => ({
  slug: entry.slug,
  title: entry.data.title,
  description: entry.data.description,
  pubDate: entry.data.pubDate,
  category: entry.data.category,
  tags: entry.data.tags,
  heroImage: entry.data.heroImage,
}));
const latest3 = mapped.slice(0, 3);
const older = mapped.slice(3);
---

<Layout title="Blog">
  <section class="section">
    <div class="section-inner">
      <p class="eyebrow">Blog</p>
      <h1>Research notes from the Fantom ecosystem.</h1>
      <p class="lead">
        Trading frameworks, DEX liquidity analysis, and yield strategy write-ups for on-chain
        operators.
      </p>

      <!-- Latest 3 posts — horizontal on desktop, vertical on mobile -->
      <div class="latest-row">
        {latest3.map((post) => <PostCard post={post} />)}
      </div>

      <!-- Older posts -->
      {older.length > 0 && (
        <div class="older-section">
          <h2>Earlier notes</h2>
          <div class="older-grid">
            {older.map((post) => <PostCard post={post} />)}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  /* Latest 3: horizontal row on desktop */
  .latest-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 48px;
  }

  /* Older posts: 2-column grid */
  .older-section {
    margin-top: 72px;
  }

  .older-section h2 {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 28px;
    color: var(--ink, #f0fdf4);
  }

  .older-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  /* Mobile: everything stacks vertically */
  @media (max-width: 900px) {
    .latest-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .older-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
