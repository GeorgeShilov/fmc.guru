---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Directory">
  <section class="section">
    <div class="section-inner">
      <p class="eyebrow">Directory</p>
      <h1>The Fantom DeFi directory.</h1>
      <p class="lead">
        Browse DEXes, farms, vaults, bridges, and protocols across the Fantom Opera ecosystem — ranked, categorized, and linked.
      </p>
      <div class="grid gateway-grid">
        <article class="card"><h3>1. DEX &amp; AMM</h3><p>Swap protocols, liquidity pools, and analytics dashboards where Fantom tokens trade.</p></article>
        <article class="card"><h3>2. Farms &amp; Yields</h3><p>Emission-based farms, staking pools, and auto-compounding vault strategies.</p></article>
        <article class="card"><h3>3. Stablecoins</h3><p>Pegged assets, algorithmic stables, and bridge-wrapped fiat tokens on Fantom.</p></article>
        <article class="card"><h3>4. Bridges</h3><p>Cross-chain bridges connecting Fantom Opera to Ethereum, BSC, and other networks.</p></article>
        <article class="card"><h3>5. Lending</h3><p>Money markets and collateralized lending protocols native to the Fantom ecosystem.</p></article>
        <article class="card"><h3>6. Tools &amp; Oracles</h3><p>Charting, portfolio trackers, price feeds, and infrastructure that powers DeFi on Fantom.</p></article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gateway-grid {
    margin-top: 42px;
  }
</style>
