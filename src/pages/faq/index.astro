---
import Layout from "@/layouts/Layout.astro";

const faqs = [
  ["What is FantomMarketCap?", "FantomMarketCap (FMC.guru) is a market intelligence platform for Fantom Opera blockchain tokens. It tracks prices, market caps, DEX listings, and liquidity across the ecosystem."],
  ["How is market cap calculated?", "Market cap is derived from circulating supply multiplied by the best available DEX price. Bridged and native assets are marked separately for clarity."],
  ["Which DEXes are covered?", "FantomMarketCap indexes major Fantom DEXes and AMMs including Sushi, Curve, PaintSwap, HyperJump, Waka, SoulSwap, Beethoven X, and others."],
  ["What do nativity markers mean?", "⁕ marks native Fantom assets, * marks bridged assets from other chains, and ★ highlights featured or curated tokens."]
];
---

<Layout title="FAQ">
  <section class="section">
    <div class="section-inner">
      <p class="eyebrow">FAQ</p>
      <h1>Clear answers before your first trade.</h1>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details class="card">
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .faq-list {
    display: grid;
    gap: 14px;
    margin-top: 40px;
  }

  summary {
    cursor: pointer;
    font-weight: 800;
    font-size: 20px;
  }

  details p {
    margin-top: 14px;
  }
</style>
